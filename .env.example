# Copy to .env before a NEW deployment; replace the placeholders locally.
# Existing volumes keep their original passwords; changing this file alone
# does not rotate credentials inside MySQL or RabbitMQ.
CITYGO_DB_PASSWORD=replace-with-a-unique-database-password
CITYGO_RABBITMQ_USERNAME=citygo
CITYGO_RABBITMQ_PASSWORD=replace-with-a-unique-rabbitmq-password
CITYGO_ADMIN_USER_IDS=
